{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Docs configuration",
  "description": "Strict repository-local configuration for documentation spaces and optional agent-workflow publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "spaces"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Configuration format version.",
      "const": 1
    },
    "title": {
      "$ref": "#/$defs/displayText"
    },
    "siteUrl": {
      "description": "Optional absolute public base URL for generated links.",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://.*[^/]$",
      "maxLength": 2048
    },
    "spaces": {
      "description": "Documentation trees rendered into independent route namespaces.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "agentWorkflows": {
      "$ref": "#/$defs/agentWorkflows"
    }
  },
  "$defs": {
    "displayText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!\\s).*\\S$"
    },
    "spaceId": {
      "description": "A lowercase route segment, or an empty string for the root space.",
      "type": "string",
      "maxLength": 80,
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*)?$"
    },
    "routePrefix": {
      "description": "One or more lowercase route segments without a leading slash.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "repoPath": {
      "description": "A normalized forward-slash relative path with no current- or parent-directory segments.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\.|(?!\\.\\.?$)(?!\\.\\.?/)(?!.*?/\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "nonDotRepoPath": {
      "allOf": [
        {
          "$ref": "#/$defs/repoPath"
        },
        {
          "not": {
            "const": "."
          }
        }
      ]
    },
    "rootFile": {
      "description": "An individual filename directly below a configured source root.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\.\\.?$)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pathList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonDotRepoPath"
      },
      "default": []
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "docsDir"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/spaceId"
        },
        "label": {
          "$ref": "#/$defs/displayText"
        },
        "docsDir": {
          "$ref": "#/$defs/nonDotRepoPath",
          "description": "Repository-relative documentation directory."
        },
        "curated": {
          "type": "boolean",
          "default": false
        },
        "showInMenu": {
          "type": "boolean",
          "default": true
        },
        "sourceRoot": {
          "$ref": "#/$defs/repoPath",
          "description": "Repository-relative root used to resolve source publication paths.",
          "default": "."
        },
        "sourceUrlBase": {
          "description": "Optional absolute HTTP(S) base URL for links to source files.",
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.*/$",
          "maxLength": 2048
        },
        "enableSnippets": {
          "description": "Allows named source regions only inside configured source trees.",
          "type": "boolean",
          "default": false
        },
        "publishCode": {
          "description": "Enables the code browser for explicitly allowed trees and extensions.",
          "type": "boolean",
          "default": false
        },
        "sourceTrees": {
          "$ref": "#/$defs/pathList",
          "description": "Source-root-relative directories allowed for snippets and code browsing."
        },
        "sourceExtensions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 17,
            "pattern": "^\\.[a-z0-9][a-z0-9.]*$"
          },
          "default": []
        },
        "excludedSourcePaths": {
          "$ref": "#/$defs/pathList",
          "description": "Source-root-relative paths removed from every source publication surface."
        },
        "browsableRootFiles": {
          "description": "Individual filenames directly below sourceRoot that may appear in the code browser.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rootFile"
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "publishCode": {
                    "const": true
                  }
                },
                "required": [
                  "publishCode"
                ]
              },
              {
                "properties": {
                  "enableSnippets": {
                    "const": true
                  }
                },
                "required": [
                  "enableSnippets"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "sourceTrees",
              "sourceExtensions"
            ],
            "properties": {
              "sourceTrees": {
                "type": "array",
                "minItems": 1
              },
              "sourceExtensions": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "browsableRootFiles": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "browsableRootFiles"
            ]
          },
          "then": {
            "properties": {
              "publishCode": {
                "const": true
              }
            },
            "required": [
              "publishCode"
            ]
          }
        }
      ]
    },
    "agentWorkflows": {
      "description": "Optional explicit projection of allowlisted agent-workflow Markdown.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "spaceId": {
          "$ref": "#/$defs/spaceId"
        },
        "manifest": {
          "$ref": "#/$defs/nonDotRepoPath",
          "description": "Repository-relative path to the explicit publication manifest."
        },
        "routePrefix": {
          "$ref": "#/$defs/routePrefix"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "spaceId",
              "manifest",
              "routePrefix"
            ],
            "properties": {
              "spaceId": {
                "$ref": "#/$defs/spaceId"
              },
              "manifest": {
                "$ref": "#/$defs/nonDotRepoPath"
              },
              "routePrefix": {
                "$ref": "#/$defs/routePrefix"
              }
            }
          },
          "else": {
            "properties": {
              "spaceId": false,
              "manifest": false,
              "routePrefix": false
            }
          }
        }
      ]
    }
  }
}

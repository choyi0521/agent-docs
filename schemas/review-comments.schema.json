{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Docs local review comments",
  "description": "Version 1 of the repository-local review data used only by the loopback preview server and authoring tools. Runtime text limits count UTF-16 code units to match browser maxlength behavior; JSON Schema maxLength remains a structural aid because it counts Unicode code points.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "comments"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "comments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/comment"
      }
    }
  },
  "$defs": {
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route",
        "body",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rc_[0-9a-f]{32}$"
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*/\\.{1,2}(?:/|$))(?!.*[\\\\?#\\u0000-\\u001f\\u007f-\\u009f\\s])(?:$|.*[^/])$",
          "description": "A normalized absolute site route without a query, fragment, empty segment, or dot segment."
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*\\s)[^#\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "quote": {
          "$ref": "#/$defs/quoteText"
        },
        "body": {
          "$ref": "#/$defs/bodyText"
        },
        "status": {
          "enum": ["open", "answered", "resolved"]
        },
        "reply": {
          "$ref": "#/$defs/bodyText"
        },
        "createdAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcTimestamp",
          "description": "Must be equal to or later than createdAt."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["answered", "resolved"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["reply"],
            "properties": {
              "reply": {
                "$ref": "#/$defs/bodyText"
              }
            }
          }
        }
      ]
    },
    "quoteText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
    },
    "bodyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "^(?!\\s)(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*\\S$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    }
  }
}
